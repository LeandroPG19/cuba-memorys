[Unit]
Description=cuba-memorys — shared MCP knowledge-graph daemon
Documentation=https://github.com/LeandroPG19/cuba-memorys
# The brain lives in a Docker Postgres. If it is not up yet the daemon still
# starts on a lazy pool and tools report the real error, so this is only a hint.
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=exec
ExecStart=%h/.local/bin/cuba-memorys-daemon serve 127.0.0.1:8787
# on-failure, not always: a clean idle shutdown exits 0, and Restart=always
# would bounce the daemon straight back up and defeat it entirely. Crashes are
# still recovered.
Restart=on-failure
RestartSec=3

# One process holds every ONNX model, so this is where the memory shows up.
# Measured peak while loading them: ~3.9 GB. MemoryHigh throttles and reclaims,
# MemoryMax OOM-kills — so Max is the last line of defence only, and losing this
# daemon is cheap when the socket unit below can relaunch it.
MemoryHigh=4500M
MemoryMax=6G
# Under real memory pressure the kernel should take this before a desktop session.
OOMScoreAdjust=200
Nice=5

# Per-model device placement. Only the reranker gains from a GPU:
#  * embedder — INT8 dynamic quantisation, which the CUDA provider has no kernel
#    for, so it always ran on the CPU anyway; registering CUDA for it only
#    reserved a VRAM arena it never computed in.
#  * reranker — genuine FP16 and the heaviest of the three. This one belongs there.
#  * nli — FP32 mDeBERTa (no FP16 upstream, INT8 breaks its entailments). Rare and
#    latency-tolerant, so the CPU costs ~150-400 ms and frees over a gigabyte.
Environment=CUBA_EMBED_DEVICE=cpu
Environment=CUBA_RERANK_DEVICE=gpu
Environment=CUBA_NLI_DEVICE=cpu

# CUDA's arena defaults to doubling its reservation on every growth instead of
# taking what the session asked for. Safe as a per-session cap only because
# exactly one model asks for CUDA.
Environment=CUBA_GPU_MEM_LIMIT_MB=2048
# Candidates per cross-encoder pass. Under fixed shapes every batch pads to 512
# tokens, so this is the main lever on the arena: 16 -> 2938 MiB, 4 -> 2364 MiB,
# with byte-identical results either way.
Environment=CUBA_RERANK_CHUNK=4

# Uncomment to have the daemon exit when no client has spoken for 20 minutes.
# Requires cuba-memorys.socket to be enabled, or nothing will bring it back.
#Environment=CUBA_IDLE_SHUTDOWN_SECS=1200

Environment=DATABASE_URL=postgresql://cuba:memorys2026@127.0.0.1:5488/brain
Environment=ONNX_MODEL_PATH=%h/.cache/cuba-memorys/models-bge-m3
Environment=ORT_DYLIB_PATH=%h/.cache/cuba-memorys/onnxruntime/libonnxruntime.so
Environment=CUBA_EMBEDDING_DIM=1024
Environment=CUBA_EMBED_MODEL=bge-m3
Environment=CUBA_POOLING=cls
Environment=CUBA_QUERY_PREFIX=
Environment=CUBA_PASSAGE_PREFIX=
Environment=CUBA_MODE=completo
# CUBA_NODE_NAME names this machine in origin_node. Left unset it falls back to
# the hostname, which is what you want unless two machines share one.
#Environment=CUBA_NODE_NAME=
Environment=CUBA_SKIP_MIGRATIONS=1
Environment=LD_LIBRARY_PATH=%h/.cache/cuba-memorys/onnxruntime
Environment=RUST_LOG=cuba_memorys=info

# Always-on mode. For socket activation — daemon absent until the first call —
# drop this section and `systemctl --user enable --now cuba-memorys.socket`
# instead, with CUBA_IDLE_SHUTDOWN_SECS above uncommented.
[Install]
WantedBy=default.target
